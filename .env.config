# 明策 MINGCE hk 非敏感开关 (入库跟踪, push 即随部署生效)
# 敏感值 (DB 密码/SECRET_KEY/各类 key) 在服务器 .env.prod, 不入库
# compose env_file 顺序: .env.prod → .env.secrets → .env.config (本文件最后, 覆盖旧值)

# 市场数据源: free=免费源(默认), coinglass=CoinGlass(续费 key 后改此行切换)
MARKET_DATA_SOURCE=CoinGlass

# TronGrid API key (充值扫链; trongrid.io 免费注册, 空 = 公共 3 QPS 限流)
TRONGRID_API_KEY=
# Etherscan V2 API key (EVM 三网充值扫链; etherscan.io 免费注册一把, 多链通用)
ETHERSCAN_API_KEY=QY785E6BX756DW7S4SAN9R3H1A6SJU2AF7
# 充值地址池: 空闲低于下限自动生成补足
DEPOSIT_POOL_MIN=20
DEPOSIT_POOL_TARGET=50

# JWT 登录态有效期
JWT_EXPIRE_HOURS=720

# CORS: 后台/前端正式域名, 逗号分隔
CORS_ORIGINS=http://localhost:8088,http://mcht.bdxapi.com

# 后台管理员白名单 (逗号分隔; 敏感配置在 .env.prod)
ADMIN_USERNAMES=admin

OKX_BASE_URL=https://www.okx.com

# SMTP 注册验证码邮件 (密码在 .env.prod)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=xxx@qq.com
SMTP_FROM=xxx@qq.com
SMTP_USE_SSL=true

# 注册邮箱验证码开关
# ---------- SMTP 注册验证码邮件 (Titan 邮箱 noreply@mingcevip.com) ----------
# SMTP_PASSWORD 敏感不入库, 由 GitHub Secrets (SMTP_PASSWORD) 写入服务器 .env.secrets
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=noreply@mingcevip.com
SMTP_FROM=noreply@mingcevip.com
SMTP_USE_SSL=true

# false = 注册无需验证码 (当前 SMTP 为占位符, 开启会导致注册失败; 且有批量注册风险)
# 接入真实 SMTP 并本地验证发信后, 方可改 true 开启验证
EMAIL_VERIFY_ENABLED=false
EMAIL_CODE_TTL_SEC=600
EMAIL_CODE_INTERVAL_SEC=60
EMAIL_CODE_MAX_ATTEMPTS=5

# 反代信任: 生产在 nginx 后, 采信 XFF 做限流按真实 IP; 直连部署必须保持 false
TRUST_X_FORWARDED_FOR=true

# 资金操作限流: 购买下单每用户每分钟上限 (防脚本刷单) / txid 补单每分钟上限 (防刷爆链上查询额度)
# 注: 运营参数 (费率/限额/限流) 现已支持后台「系统 → 参数配置」在线修改, 即时生效;
# 这里的 env 值仅作默认值兜底 (数据库 hk_config 表有覆盖值时以覆盖为准)
PURCHASE_RATE_LIMIT=10
DEPOSIT_CLAIM_RATE_LIMIT=5

# WebRTC TURN 地址 (凭据在 .env.prod)
TURN_URLS=turn:8.216.41.32:3478?transport=udp,turn:8.216.41.32:3478?transport=tcp
TURN_USERNAME=bdxlh

# ── APNs iOS 远程推送 ──
# 开关 + 非敏感标识入库; p8 私钥走 .env.secrets (GitHub Secrets: APNS_KEY_TEXT)
APNS_ENABLED=true
APNS_KEY_ID=26N93J78HW
APNS_TEAM_ID=C4Y8S5CHFT
APNS_BUNDLE_ID=com.hkmc.noahsark
APNS_USE_SANDBOX=false
# 行情预警轮询间隔(秒)
PRICE_ALERT_INTERVAL_SEC=30
