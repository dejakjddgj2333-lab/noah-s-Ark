# 明策 MINGCE hk 生产环境配置（私有仓库, 直接入库）
# docker-compose.yml 的 env_file 指向此文件; 改完 push 即随部署生效
APP_ENV=prod

# 与 okx 后端共用 PG (只读 news_articles / 行情)
DATABASE_URL=postgresql+asyncpg://info:ybFBSYy3HcAGzFtr@8.216.41.32:5432/info

# JWT
SECRET_KEY=532db33bbb56a43c2c31d4e31320678d53cf6e0b2db3930580eb9c6449c1cf6c
JWT_EXPIRE_HOURS=720

# CORS: 后台/前端正式域名, 逗号分隔（配好后填, 如 https://admin.example.com）
