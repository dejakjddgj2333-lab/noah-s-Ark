# 明策 MINGCE hk 后端环境变量示例
# 本地: cp .env.example .env  生产: 在服务器运行目录建 .env.prod（不入库）

# ---------- 运行环境 ----------
APP_ENV=dev   # 生产填 prod（prod 下 SECRET_KEY 必须改）

# ---------- 数据库 ----------
# 生产指向与 okx 共享的 PostgreSQL（host 网络用 127.0.0.1）
DATABASE_URL=sqlite+aiosqlite:///./hk_dev.db
# DATABASE_URL=postgresql+asyncpg://user:pass@127.0.0.1:5432/okx

# ---------- JWT ----------
SECRET_KEY=dev-only-change-me
JWT_EXPIRE_HOURS=24

# ---------- CORS（逗号分隔，后台/前端域名）----------
CORS_ORIGINS=http://localhost:8088,http://localhost:5217

# ---------- 第三方 ----------
COINGLASS_API_KEY=
OKX_BASE_URL=https://www.okx.com

# ---------- SMTP 注册验证码邮件 ----------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
# 关闭后注册跳过验证码校验（测试用）
EMAIL_VERIFY_ENABLED=true

# ---------- 验证码策略 ----------
EMAIL_CODE_TTL_SEC=600
EMAIL_CODE_INTERVAL_SEC=60
