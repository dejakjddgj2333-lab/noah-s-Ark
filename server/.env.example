# 共享库 (与 okx 后端同一库; 本地开发可 sqlite 回退)
DATABASE_URL=sqlite+aiosqlite:///./hk_dev.db
# 生产: DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/okxdb

SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=24

CORS_ORIGINS=http://localhost:8088,http://localhost:5217

# 行情数据源
OKX_BASE_URL=https://www.okx.com
COINGLASS_API_KEY=

# 注册验证码邮件 SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true

EMAIL_CODE_TTL_SEC=600
EMAIL_CODE_INTERVAL_SEC=60
